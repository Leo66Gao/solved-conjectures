import Axis
import Mathlib.Analysis.InnerProductSpace.PiL2

namespace Erdos23
open scoped InnerProductSpace BigOperators

/-- The punctured binary Golay code, generated by successive shifts of 2787. -/
def binarySpan : List ℕ → List ℕ
  | [] => [0]
  | v :: vs => binarySpan vs ++ (binarySpan vs).map (fun x => v ^^^ x)

theorem binarySpan_xor (vs : List ℕ) {x y : ℕ}
    (hx : x ∈ binarySpan vs) (hy : y ∈ binarySpan vs) : x ^^^ y ∈ binarySpan vs := by
  induction vs generalizing x y with
  | nil =>
    simp [binarySpan] at hx hy ⊢
    simp [hx,hy]
  | cons v vs ih =>
    simp only [binarySpan, List.mem_append, List.mem_map] at hx hy ⊢
    rcases hx with hx | ⟨x,hx,rfl⟩ <;> rcases hy with hy | ⟨y,hy,rfl⟩
    · exact Or.inl (ih hx hy)
    · exact Or.inr ⟨_, ih hx hy, by rw [← Nat.xor_assoc, Nat.xor_comm v x, Nat.xor_assoc]⟩
    · exact Or.inr ⟨_, ih hx hy, by rw [Nat.xor_assoc]⟩
    · apply Or.inl
      rw [show (v ^^^ x) ^^^ (v ^^^ y) = (v ^^^ v) ^^^ (x ^^^ y) by ac_rfl,
        Nat.xor_self, Nat.zero_xor]
      exact ih hx hy

def puncturedCode : List ℕ := binarySpan (List.range 12 |>.map (fun i => 2787 <<< i))

def indicator (w : ℕ) (i : Fin 23) : ℕ := if w.testBit i.val then 1 else 0
def weight (w : ℕ) : ℕ := (List.range 23).foldl (fun a i => a + if w.testBit i then 1 else 0) 0

def blocks : List ℕ := puncturedCode.filter (fun w => weight w == 7)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem blocks_length : blocks.length = 253 := by decide

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem blocks_nodup : blocks.Nodup := by decide

def goodWord (w : ℕ) : Bool :=
  decide (w = 0 ∨ weight w = 7 ∨ weight w = 8 ∨ weight w = 11 ∨ weight w = 12 ∨
    weight w = 15 ∨ weight w = 16 ∨ weight w = 23)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem code_checked : puncturedCode.all goodWord = true := by decide

theorem code_weight {w : ℕ} (hw : w ∈ puncturedCode) (hn : w ≠ 0) :
    weight w = 7 ∨ weight w = 8 ∨ weight w = 11 ∨ weight w = 12 ∨
    weight w = 15 ∨ weight w = 16 ∨ weight w = 23 := by
  have H := List.all_eq_true.mp code_checked w hw
  simpa [goodWord,hn] using H


private def digit (w i : ℕ) : ℕ := if w.testBit i then 1 else 0

private theorem fold_digit (w : ℕ) (l : List ℕ) (a : ℕ) :
    l.foldl (fun a i => a + digit w i) a = a + (l.map (digit w)).sum := by
  induction l generalizing a with
  | nil => simp
  | cons i l ih => simp [ih, Nat.add_assoc]

theorem weight_eq (w : ℕ) : weight w = ∑ i : Fin 23, indicator w i := by
  unfold weight
  change (List.range 23).foldl (fun a i => a + digit w i) 0 =
    ∑ i : Fin 23, digit w i.val
  rw [fold_digit, zero_add, Fin.sum_univ_eq_sum_range,
    ← List.sum_toFinset (digit w) List.nodup_range, List.toFinset_range]

@[irreducible] def golayWord (i : Fin 253) : ℕ := blocks.get (Fin.cast blocks_length.symm i)

private theorem golayWord_mem (i : Fin 253) : golayWord i ∈ blocks := by
  unfold golayWord
  exact List.get_mem blocks _

private theorem getCast_injective {l : List ℕ} (hh : l.Nodup) {m : ℕ} (hn : l.length = m) :
    Function.Injective (fun i : Fin m => l.get (Fin.cast hn.symm i)) := by
  intro i j h
  have he := (List.Nodup.injective_get hh) h
  apply Fin.ext
  exact congrArg (fun p : Fin l.length => p.val) he

private theorem golayWord_injective : Function.Injective golayWord := by
  unfold golayWord
  exact getCast_injective blocks_nodup blocks_length

private theorem golayWord_ok (i : Fin 253) : golayWord i ∈ puncturedCode ∧ weight (golayWord i) = 7 := by
  simpa [blocks, List.mem_filter] using golayWord_mem i

private def overlap (a b : ℕ) : ℕ := ∑ i : Fin 23, indicator a i * indicator b i

private theorem weight_xor_add (a b : ℕ) :
    weight (a ^^^ b) + 2 * overlap a b = weight a + weight b := by
  rw [weight_eq, weight_eq, weight_eq]
  unfold overlap
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  unfold indicator
  rw [Nat.testBit_xor]
  cases a.testBit i.val <;> cases b.testBit i.val <;> decide

private theorem overlap_distinct (i j : Fin 253) (hne : i ≠ j) :
    overlap (golayWord i) (golayWord j) = 1 ∨ overlap (golayWord i) (golayWord j) = 3 := by
  have H := weight_xor_add (golayWord i) (golayWord j)
  rw [(golayWord_ok i).2,(golayWord_ok j).2] at H
  have hn : golayWord i ^^^ golayWord j ≠ 0 := by
    intro hz
    apply hne
    apply golayWord_injective
    have h' := congrArg (fun n => n ^^^ golayWord j) hz
    change (golayWord i ^^^ golayWord j) ^^^ golayWord j = 0 ^^^ golayWord j at h'
    rwa [Nat.xor_assoc,Nat.xor_self,Nat.xor_zero,Nat.zero_xor] at h' 
  rcases code_weight (binarySpan_xor _ (golayWord_ok i).1 (golayWord_ok j).1) hn with h|h|h|h|h|h|h <;> omega

private theorem overlap_self (i : Fin 253) : overlap (golayWord i) (golayWord i) = 7 := by
  unfold overlap
  rw [← (golayWord_ok i).2, weight_eq]
  apply Finset.sum_congr rfl
  intro k _
  simp [indicator]


abbrev E23 := EuclideanSpace ℝ (Fin 23)

private noncomputable def beta : ℝ := (Real.sqrt 27 - 2) / 23

private theorem beta_eq : 4 * beta + 23 * beta^2 = 1 := by
  have h : (Real.sqrt 27)^2 = 27 := Real.sq_sqrt (by norm_num)
  unfold beta
  nlinarith

private noncomputable def realization (u : Fin 23 → ℝ) : E23 :=
  WithLp.toLp 2 (fun i => 2*u i + beta*(∑ j,u j))

private theorem realization_inner (u v : Fin 23 → ℝ) :
    ⟪realization u,realization v⟫_ℝ = 4 * (∑ i,u i * v i) + (∑ i,u i)*(∑ i,v i) := by
  rw [PiLp.inner_apply]
  simp only [RCLike.inner_apply', RCLike.conj_to_real]
  change (∑ i : Fin 23, (2*u i + beta*(∑ j,u j))*(2*v i + beta*(∑ j,v j))) = _
  let U := ∑ i, u i
  let V := ∑ i, v i
  change (∑ i : Fin 23, (2*u i + beta*U)*(2*v i + beta*V)) = 4*(∑ i,u i*v i)+U*V
  calc
    _ = ∑ i : Fin 23, (4*(u i*v i) + (2*beta*V)*u i + (2*beta*U)*v i + beta^2*U*V) := by
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ = 4*(∑ i,u i*v i) + (4*beta+23*beta^2)*U*V := by
      simp only [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const, Finset.card_univ,
        Fintype.card_fin, nsmul_eq_mul]
      dsimp [U, V]
      ring
    _ = _ := by rw [beta_eq, one_mul]

private def bitR (j : Fin 253) (i : Fin 23) : ℝ := indicator (golayWord j) i

private theorem bitR_sum (j : Fin 253) : ∑ i, bitR j i = 7 := by
  change (∑ i : Fin 23, ((indicator (golayWord j) i : ℕ) : ℝ)) = 7
  rw [← Nat.cast_sum, ← weight_eq, (golayWord_ok j).2]
  norm_num

private theorem bitR_prod (j k : Fin 253) :
    ∑ i, bitR j i * bitR k i = (overlap (golayWord j) (golayWord k) : ℝ) := by
  simp only [bitR, overlap, Nat.cast_sum, Nat.cast_mul]

private noncomputable def coeffWord (j : Fin 253) (i : Fin 23) : ℝ :=
  bitR j i / 2 - 1/6

private theorem coeffWord_sum (j : Fin 253) : ∑ i, coeffWord j i = -(1/3 : ℝ) := by
  simp only [coeffWord, Finset.sum_sub_distrib, div_eq_mul_inv,
    ← Finset.sum_mul, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  rw [bitR_sum]
  norm_num

private theorem wordWord_inner (j k : Fin 253) :
    ⟪realization (coeffWord j),realization (coeffWord k)⟫_ℝ =
      (overlap (golayWord j) (golayWord k) : ℝ) - 2 := by
  rw [realization_inner, coeffWord_sum, coeffWord_sum]
  have h :
      (∑ i, coeffWord j i * coeffWord k i) =
        ∑ i : Fin 23, ((1/4)* (bitR j i*bitR k i) - (1/12)*bitR j i -
          (1/12)*bitR k i + (1/36)) := by
    apply Finset.sum_congr rfl
    intro i _
    unfold coeffWord
    ring
  rw [h]
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
    Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  rw [bitR_prod,bitR_sum,bitR_sum]
  ring

private abbrev Labels := Fin 23 ⊕ Fin 253

private noncomputable def vector (l : Labels) : E23 :=
  realization (match l with
    | .inl i => fun k => if i = k then 1 else 0
    | .inr j => coeffWord j)

private theorem vector_basis_inner (i j : Fin 23) :
    ⟪vector (.inl i),vector (.inl j)⟫_ℝ = if i=j then 5 else 1 := by
  unfold vector
  rw [realization_inner]
  simp_rw [ite_mul,one_mul,zero_mul]
  simp only [Finset.sum_ite_eq, Finset.mem_univ, ite_true]
  by_cases h : i = j
  · subst j
    norm_num
  · simp [h,Ne.symm h]

private theorem vector_mixed_inner (i : Fin 23) (j : Fin 253) :
    ⟪vector (.inl i),vector (.inr j)⟫_ℝ = 2*bitR j i-1 := by
  unfold vector
  rw [realization_inner,coeffWord_sum]
  simp_rw [ite_mul,one_mul,zero_mul]
  simp only [Finset.sum_ite_eq, Finset.mem_univ, ite_true,coeffWord]
  ring

private theorem vector_self (i : Labels) : ⟪vector i,vector i⟫_ℝ = 5 := by
  rcases i with i|i
  · rw [vector_basis_inner, ite_eq_left rfl]
  · change ⟪realization (coeffWord i),realization (coeffWord i)⟫_ℝ = _
    rw [wordWord_inner,overlap_self]
    norm_num

private theorem vector_pair {i j : Labels} (h : i ≠ j) :
    ⟪vector i,vector j⟫_ℝ = 1 ∨ ⟪vector i,vector j⟫_ℝ = -1 := by
  rcases i with i|i <;> rcases j with j|j
  · left
    rw [vector_basis_inner, ite_eq_right (fun e => h (congrArg Sum.inl e))]
  · rw [vector_mixed_inner]
    unfold bitR indicator
    split_ifs <;> norm_num
  · rw [real_inner_comm,vector_mixed_inner]
    unfold bitR indicator
    split_ifs <;> norm_num
  · change ⟪realization (coeffWord i),realization (coeffWord j)⟫_ℝ = _ ∨
       ⟪realization (coeffWord i),realization (coeffWord j)⟫_ℝ = _
    rw [wordWord_inner]
    rcases overlap_distinct i j (fun e => h (congrArg Sum.inr e)) with e|e <;> rw [e] <;> norm_num


private def excludeAnchor : Fin 22 ⊕ Fin 253 ↪ Labels where
  toFun
    | .inl i => .inl i.succ
    | .inr i => .inr i
  inj' := by
    rintro (i|i) (j|j) h <;> simp_all

private def label275 : Fin 275 ↪ Labels :=
  (finSumFinEquiv : Fin 22 ⊕ Fin 253 ≃ Fin (22+253)).symm.toEmbedding.trans excludeAnchor

private theorem label275_ne (i : Fin 275) : label275 i ≠ .inl 0 := by
  unfold label275
  change excludeAnchor ((finSumFinEquiv : Fin 22 ⊕ Fin 253 ≃ Fin (22+253)).symm i) ≠ _
  cases (finSumFinEquiv : Fin 22 ⊕ Fin 253 ≃ Fin (22+253)).symm i with
  | inl x =>
    intro h
    have h' : (Sum.inl x.succ : Labels) = .inl 0 := h
    exact Fin.succ_ne_zero x (Sum.inl.inj h')
  | inr x => simp [excludeAnchor]

private noncomputable def poleBase : E23 := vector (.inl 0)
private noncomputable def coreSign (i : Fin 275) : ℝ := ⟪vector (label275 i),poleBase⟫_ℝ
private theorem coreSign_disj (i : Fin 275) : coreSign i = 1 ∨ coreSign i = -1 :=
  vector_pair (label275_ne i)

/-- Explicit McLaughlin core obtained by orienting the Golay lines and
projecting off the distinguished anchor. -/
noncomputable def mclaughlinCore (i : Fin 275) : E23 :=
  coreSign i • vector (label275 i) - (1/5 : ℝ) • poleBase

private noncomputable def golayPole : E23 := (Real.sqrt 24 / 5) • poleBase

private theorem poleBase_self : ⟪poleBase,poleBase⟫_ℝ = 5 := vector_self _

private theorem coreSign_sq (i : Fin 275) : coreSign i ^ 2 = 1 := by
  rcases coreSign_disj i with h|h <;> rw [h] <;> norm_num

private theorem core_inner (i j : Fin 275) :
    ⟪mclaughlinCore i,mclaughlinCore j⟫_ℝ =
      coreSign i * coreSign j * ⟪vector (label275 i),vector (label275 j)⟫_ℝ - 1/5 := by
  have hi : ⟪vector (label275 i),poleBase⟫_ℝ = coreSign i := rfl
  have hj : ⟪poleBase,vector (label275 j)⟫_ℝ = coreSign j := real_inner_comm _ _
  unfold mclaughlinCore
  simp only [inner_sub_left,inner_sub_right,real_inner_smul_left,real_inner_smul_right,
    poleBase_self,hi,hj]
  nlinarith [coreSign_sq i, coreSign_sq j]

private theorem core_self (i : Fin 275) : ⟪mclaughlinCore i,mclaughlinCore i⟫_ℝ = 24/5 := by
  rw [core_inner,vector_self, ← pow_two,coreSign_sq]
  norm_num

private theorem core_orth (i : Fin 275) : ⟪mclaughlinCore i,golayPole⟫_ℝ = 0 := by
  unfold mclaughlinCore golayPole
  rw [real_inner_smul_right,inner_sub_left,real_inner_smul_left,real_inner_smul_left,poleBase_self]
  change (Real.sqrt 24 / 5) * (coreSign i * coreSign i - 1/5*5) = 0
  rw [← pow_two, coreSign_sq]
  ring

private theorem golayPole_self : ⟪golayPole,golayPole⟫_ℝ = 24/5 := by
  unfold golayPole
  rw [real_inner_smul_left,real_inner_smul_right,poleBase_self]
  have h : (Real.sqrt 24)^2 = 24 := Real.sq_sqrt (by norm_num)
  nlinarith

private theorem core_two (i j : Fin 275) (h : i ≠ j) :
    sqDist (mclaughlinCore i) (mclaughlinCore j) = 8 ∨
    sqDist (mclaughlinCore i) (mclaughlinCore j) = 12 := by
  have hf : sqDist (mclaughlinCore i) (mclaughlinCore j) =
      10 - 2*(coreSign i * coreSign j * ⟪vector (label275 i),vector (label275 j)⟫_ℝ) := by
    unfold sqDist
    rw [inner_sub_left,inner_sub_right,inner_sub_right,core_self,core_self,
      real_inner_comm (mclaughlinCore i) (mclaughlinCore j),core_inner]
    ring
  rw [hf]
  rcases coreSign_disj i with hi|hi <;> rcases coreSign_disj j with hj|hj <;>
    rcases vector_pair (fun e => h (label275.injective e)) with hv|hv <;>
    rw [hi,hj,hv] <;> norm_num

/-- The 278-point lower bound is unconditional, in real dimension 23. -/
theorem exists_isosceles_278_fin23 :
    ∃ f : Fin 278 ↪ E23, ∀ i j k, i ≠ j → i ≠ k → j ≠ k → Iso3 (f i) (f j) (f k) := by
  apply axial_278_of_275 mclaughlinCore golayPole (24/5) 8 12
  · norm_num
  · exact core_self
  · exact golayPole_self
  · exact core_orth
  · intro i j he
    by_contra hn
    rcases core_two i j hn with hd|hd <;> rw [he] at hd <;> simp [sqDist] at hd
  · exact core_two

#print axioms exists_isosceles_278_fin23
end Erdos23
